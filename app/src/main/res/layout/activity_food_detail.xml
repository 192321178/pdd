<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Food Image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <ImageView
                    android:id="@+id/imgDetail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#2A2A2A"/>

                <!-- Dim overlay when claimed -->
                <View
                    android:id="@+id/viewDimOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#AA000000"
                    android:visibility="gone"/>

                <!-- Claimed overlay -->
                <LinearLayout
                    android:id="@+id/layoutClaimed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLAIMED"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_claimed_badge"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"/>

                </LinearLayout>

                <!-- Back button -->
                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="&#8592;"
                    android:textSize="22sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:background="@drawable/bg_timer_badge"
                    android:layout_margin="16dp"/>

            </FrameLayout>

            <!-- Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1E1E1E"
                android:padding="20dp">

                <!-- Title + Timer -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDetailFoodName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Food Name"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                        <TextView
                            android:id="@+id/tvDetailCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cooked Meal"
                            android:textSize="13sp"
                            android:textColor="@color/green_primary"
                            android:background="@drawable/bg_category_selected"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                    <!-- Countdown -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_alignParentEnd="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expires in"
                            android:textSize="11sp"
                            android:textColor="#E53935"/>

                        <TextView
                            android:id="@+id/tvCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="01 : 27 : 28"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:text="hr"
                                android:textSize="10sp"
                                android:textColor="@color/gray_text"
                                android:gravity="center"/>

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:text="min"
                                android:textSize="10sp"
                                android:textColor="@color/gray_text"
                                android:gravity="center"/>

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:text="sec"
                                android:textSize="10sp"
                                android:textColor="@color/gray_text"
                                android:gravity="center"/>

                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>

                <!-- Info Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_box"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#127859;  Quantity"
                            android:textSize="15sp"
                            android:textColor="#AAAAAA"/>

                        <TextView
                            android:id="@+id/tvDetailQuantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 plates"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_alignParentEnd="true"/>

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#333333"
                        android:layout_marginBottom="14dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#128205;  Location"
                            android:textSize="15sp"
                            android:textColor="#AAAAAA"/>

                        <TextView
                            android:id="@+id/tvDetailLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_alignParentEnd="true"/>

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#333333"
                        android:layout_marginBottom="14dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#9201;  Pickup window"
                            android:textSize="15sp"
                            android:textColor="#AAAAAA"/>

                        <TextView
                            android:id="@+id/tvDetailPickup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Now"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_alignParentEnd="true"/>

                    </RelativeLayout>

                </LinearLayout>

                <!-- Halal Tag -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="halal"
                    android:textSize="12sp"
                    android:textColor="@color/green_primary"
                    android:background="@drawable/bg_tag_green"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="16dp"/>

                <!-- About -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About this listing"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvDetailDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fresh and ready!"
                    android:textSize="14sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginBottom="20dp"/>

                <!-- Donor Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_box"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Donor"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvDonorAvatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="Y"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:background="@drawable/bg_avatar"
                            android:layout_marginEnd="14dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDonorName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="You"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="&#9733; 4.9 · 23 donations"
                                android:textSize="13sp"
                                android:textColor="#AAAAAA"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Bar — Claim + Message buttons -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="16dp"
        android:layout_alignParentBottom="true">

        <Button
            android:id="@+id/btnClaimFood"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="&#127860; Claim This Food"
            android:textSize="17sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/green_primary"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnMessageDonor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="&#128172; Message Donor"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:backgroundTint="#2A2A2A"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</RelativeLayout>