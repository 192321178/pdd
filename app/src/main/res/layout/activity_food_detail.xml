<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Food Image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <ImageView
                    android:id="@+id/imgDetail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#1E293B"/>

                <!-- Status Overlay (optional dimming) -->
                <View
                    android:id="@+id/viewDimOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#99000000"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/layoutClaimed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLAIMED"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_claimed_badge"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"/>

                </LinearLayout>

                <!-- Back button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardElevation="4dp"
                    android:layout_margin="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="#F8FAFC"/>

                </androidx.cardview.widget.CardView>

                <!-- Hamburger Menu Button (≡) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardElevation="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_more"
                        app:tint="#F8FAFC"/>

                </androidx.cardview.widget.CardView>

                <!-- Countdown Timer -->
                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:background="#CC000000"
                    android:padding="8dp"
                    android:text="00 : 00 : 00"
                    android:textColor="#00C853"
                    android:textStyle="bold"/>

            </FrameLayout>

            <!-- Details Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginTop="-20dp"
                android:background="@drawable/bg_detail_rounded"
                android:backgroundTint="#0F172A">

                <TextView
                    android:id="@+id/tvDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COOKED MEAL"
                    android:textSize="12sp"
                    android:textColor="#00C853"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvDetailFoodName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organic Tomato Rice"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:layout_marginBottom="16dp"/>

                <!-- Information Grid -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📦  Quantity"
                                android:textColor="#94A3B8"/>
                            <TextView
                                android:id="@+id/tvDetailQuantity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 Servings"
                                android:textStyle="bold"
                                android:textColor="#F8FAFC"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#334155" android:layout_marginTop="14dp" android:layout_marginBottom="14dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍  Location"
                                android:textColor="#94A3B8"/>
                            <TextView
                                android:id="@+id/tvDetailLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chennai"
                                android:textStyle="bold"
                                android:textColor="#F8FAFC"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#334155" android:layout_marginTop="14dp" android:layout_marginBottom="14dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱️  Pickup window"
                                android:textColor="#94A3B8"/>
                            <TextView
                                android:id="@+id/tvDetailPickup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Now · Chennai"
                                android:textStyle="bold"
                                android:textColor="#F8FAFC"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tags Row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="halal"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_chip_selected"
                    android:backgroundTint="#059669"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginBottom="24dp"/>

                <!-- Description Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About this listing"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvDetailDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tasty home-cooked meal."
                    android:textSize="14sp"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="32dp"/>

                <!-- Donor Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Donor"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#F8FAFC"
                            android:layout_marginBottom="16dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvDonorAvatar"
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:text="S"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:background="@drawable/bg_avatar"
                                android:backgroundTint="#10B981"
                                android:layout_marginEnd="16dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDonorName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Santhosh"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#F8FAFC"/>

                                <TextView
                                    android:id="@+id/tvDonorRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="★ 4.9 · 32 donations"
                                    android:textSize="13sp"
                                    android:textColor="#94A3B8"
                                    android:layout_marginTop="2dp"/>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- View Reviews Button -->
                <TextView
                    android:id="@+id/tvViewReviews"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="⭐ View Reviews"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="#22c55e"
                    android:textStyle="bold"
                    android:background="#1A2233"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#0F172A"
        android:layout_alignParentBottom="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClaimFood"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CLAIM FOOD"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#10B981"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMessageDonor"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="MESSAGE DONOR"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            android:textColor="#F8FAFC"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            app:backgroundTint="#1E293B"/>

    </LinearLayout>

</RelativeLayout>