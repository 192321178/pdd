<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="24dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image Section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <!-- Default emoji background -->
            <LinearLayout
                android:id="@+id/layoutNoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="#FAFAFA">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥗"
                    android:textSize="56sp"/>

            </LinearLayout>

            <!-- User uploaded image -->
            <ImageView
                android:id="@+id/imgFoodCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <!-- Status Badges Overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/tvCardCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home Cooked"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/bg_category_label"
                    android:backgroundTint="#212121"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"/>

            </LinearLayout>

            <!-- Fresh Indicator Overlay -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_red"
                        android:backgroundTint="#00C853"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FRESH"
                        android:textSize="9sp"
                        android:textColor="#00C853"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Claimed Overlay -->
            <TextView
                android:id="@+id/tvCardClaimed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="CLAIMED"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="#99000000"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Card Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvCardFoodName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organic Tomato Rice"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="★ 4.9"
                    android:textColor="#FFC107"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvCardQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 servings"
                    android:textSize="13sp"
                    android:textColor="#757575"
                    android:layout_marginEnd="16dp"/>

                <TextView
                    android:id="@+id/tvCardTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expires in 2h"
                    android:textSize="12sp"
                    android:textColor="#D32F2F"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- User Info & Action -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true">

                    <TextView
                        android:id="@+id/tvAvatarInit"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="K"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        android:backgroundTint="#00C853"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvCardUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Karthik"
                        android:textSize="13sp"
                        android:textColor="#424242"
                        android:fontFamily="sans-serif-medium"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="DETAILS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#00C853"
                    android:letterSpacing="0.05"/>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
