<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">

        <!-- Image Section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <!-- Default emoji background (image இல்லன்னா) -->
            <LinearLayout
                android:id="@+id/layoutNoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="#E8F5E9">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#127860;"
                    android:textSize="60sp"/>

            </LinearLayout>

            <!-- User uploaded image -->
            <ImageView
                android:id="@+id/imgFoodCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <!-- Timer badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_timer_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_red"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fresh!"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Category label -->
            <TextView
                android:id="@+id/tvCardCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cooked Meal"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_category_label"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"/>

            <!-- ✅ Claimed Badge (center of image) -->
            <TextView
                android:id="@+id/tvCardClaimed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLAIMED"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_claimed_badge"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_gravity="center"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Card Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Food Name -->
            <TextView
                android:id="@+id/tvCardFoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Name"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="6dp"/>

            <!-- Quantity -->
            <TextView
                android:id="@+id/tvCardQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 plates"
                android:textSize="13sp"
                android:textColor="@color/gray_text"
                android:layout_marginBottom="6dp"/>
            <!-- Time remaining -->
            <TextView
                android:id="@+id/tvCardTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h 30m left"
                android:textSize="12sp"
                android:textColor="#E53935"
                android:layout_marginBottom="6dp"
                android:visibility="gone"/>

            <!-- Description -->
            <TextView
                android:id="@+id/tvCardDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fresh and ready!"
                android:textSize="13sp"
                android:textColor="@color/gray_text"
                android:layout_marginBottom="12dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="12dp"/>

            <!-- User Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Avatar -->
                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="Y"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvCardUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>

                </LinearLayout>

                <!-- Star Rating -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#9733;"
                        android:textSize="16sp"
                        android:textColor="#FFC107"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5.0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>