<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Image Section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/imgFoodCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"/>

            <LinearLayout
                android:id="@+id/layoutNoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F5F5F5"
                android:gravity="center"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍲"
                    android:textSize="48sp"/>
            </LinearLayout>

            <!-- Fresh Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_claimed_badge"
                android:backgroundTint="#2D3436"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_red"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fresh!"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Category Tag -->
            <TextView
                android:id="@+id/tvCardCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:text="Cooked Meal"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_claimed_badge"
                android:backgroundTint="#2D3436"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>

            <!-- Claimed ✓ semi-transparent green banner at bottom of image -->
            <TextView
                android:id="@+id/tvCardClaimed"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:background="#CC00C853"
                android:text="✓ Claimed"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Content Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvCardFoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Curd rice"
                android:textColor="#2D3436"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvCardQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 plate"
                android:textColor="#636E72"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvCardTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7m left"
                android:textColor="#FF7675"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvCardDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tsty"
                android:textColor="#636E72"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- User Info Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true">

                    <TextView
                        android:id="@+id/tvAvatarInit"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_avatar"
                        android:backgroundTint="#2ECC71"
                        android:text="Y"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tvCardUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Santhosh"
                        android:textColor="#2D3436"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="★ 5.0"
                    android:textColor="#FDCB6E"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>