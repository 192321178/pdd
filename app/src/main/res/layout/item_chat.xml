<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Avatar -->
        <TextView
            android:id="@+id/tvChatAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="K"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="#00C853"
            android:layout_marginEnd="16dp"/>

        <!-- Name + Food + Last message -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/tvChatFoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regarding: Tomato Rice"
                android:textSize="13sp"
                android:textColor="#00C853"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvLastMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi, is the food still available?"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- Time + Unread Badge (like WhatsApp) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvChatTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Just now"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:layout_gravity="end"/>

            <!-- Unread badge (WhatsApp style green circle) -->
            <TextView
                android:id="@+id/tvUnreadBadge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:text="1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/bg_avatar"
                android:backgroundTint="#00C853"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F5F5F5"
        android:layout_marginStart="92dp"/>

</LinearLayout>