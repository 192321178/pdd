<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOOD NEAR YOU"
                android:textSize="11sp"
                android:textColor="#95A5A6"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ShareBite"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#000000"/>
        </LinearLayout>

        <!-- Bell icon — fixed with proper background circle -->
        <FrameLayout
            android:id="@+id/btnNotification"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="#F1F2F6">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="🔔"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/tvNotificationBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/bg_dot_red"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:visibility="gone"/>
        </FrameLayout>
    </RelativeLayout>

    <!-- Search Bar — fixed icon position -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_search_bar">

        <TextView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:text="🔍"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"/>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search food listings..."
            android:paddingStart="46dp"
            android:paddingEnd="12dp"
            android:background="@null"
            android:textSize="14sp"
            android:textColor="#212121"
            android:textColorHint="#95A5A6"
            android:singleLine="true"
            android:imeOptions="actionSearch"/>
    </RelativeLayout>

    <!-- Filter Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/chipAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:background="@drawable/bg_chip_selected"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:id="@+id/chipCooked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cooked"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:background="@drawable/bg_chip_unselected"
            android:textColor="#2D3436"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:id="@+id/chipProduce"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Produce"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:background="@drawable/bg_chip_unselected"
            android:textColor="#2D3436"/>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="← Skip" android:textColor="#E74C3C" android:textSize="12sp"/>
        <TextView android:id="@+id/tvListingCount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="0 listings" android:textColor="#95A5A6" android:textSize="12sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Claim →" android:textColor="#2ECC71" android:textSize="12sp"/>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/feedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/foodCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>