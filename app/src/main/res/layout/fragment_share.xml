<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="100dp">

        <!-- Header Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post Food"
                    android:textSize="32sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#212121" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share your extra food with others"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

        </RelativeLayout>

        <!-- Photo Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutAddPhoto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F5F5F5"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#00C853"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Food Photo"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#424242"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Image Preview -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPhotoPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:visibility="gone"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/imgPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

        </androidx.cardview.widget.CardView>

        <!-- Form Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOOD DETAILS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#00C853"
            android:letterSpacing="0.05"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etFoodName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Name of food item"
            android:textColorHint="#9E9E9E"
            android:textColor="#212121"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="#F8F8F8"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- Category Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATEGORY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#00C853"
            android:letterSpacing="0.05"
            android:layout_marginBottom="12dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:id="@+id/chipCookedMeal"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_category_unselected"
                android:backgroundTint="#F8F8F8"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cooked Meal"
                    android:textColor="#424242"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipFreshProduce"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_category_unselected"
                android:backgroundTint="#F8F8F8"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Produce"
                    android:textColor="#424242"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipPackaged"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_category_unselected"
                android:backgroundTint="#F8F8F8"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Packaged"
                    android:textColor="#424242"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipBakery"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_category_unselected"
                android:backgroundTint="#F8F8F8"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bakery"
                    android:textColor="#424242"
                    android:textSize="13sp"/>
            </LinearLayout>
        </GridLayout>

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Quantity (e.g. 2 servings)"
            android:textColorHint="#9E9E9E"
            android:textColor="#212121"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="#F8F8F8"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Pickup Location"
            android:textColorHint="#9E9E9E"
            android:textColor="#212121"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="#F8F8F8"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AVAILABILITY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#00C853"
            android:letterSpacing="0.05"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/etExpiryHours"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:hint="Hours"
                android:textColorHint="#9E9E9E"
                android:textColor="#212121"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#F8F8F8"
                android:gravity="center"
                android:inputType="number"
                android:layout_marginEnd="12dp"/>

            <EditText
                android:id="@+id/etExpiryMins"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:hint="Mins"
                android:textColorHint="#9E9E9E"
                android:textColor="#212121"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#F8F8F8"
                android:gravity="center"
                android:inputType="number" />
        </LinearLayout>

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Short description about the food..."
            android:textColorHint="#9E9E9E"
            android:textColor="#212121"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="#F8F8F8"
            android:padding="16dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="SHARE FOOD"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="16dp"
            app:backgroundTint="#00C853"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
